{
  "name": "youware-react-template",
  "private": true,
  "version": "1.47.3",
  "type": "module",
  "main": "electron/main.cjs",
  "author": "veradekorasyon.store",
  "description": "veradekorasyon Oyun Salonu — 101 Okey, Okey, Domino, Batak masaüstü istemcisi (Electron)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && python3 scripts/deploy-ftp.py",
    "smoke": "vite build && node scripts/smoke-test.mjs",
    "electron": "electron .",
    "electron:dev": "electron . --dev",
    "dist:win": "vite build && electron-builder --win --x64"
  },
  "dependencies": {
    "@headlessui/react": "^1.7.18",
    "cannon-es": "^0.20.0",
    "clsx": "^2.1.0",
    "framer-motion": "^11.0.8",
    "gsap": "^3.13.0",
    "i18next": "^23.10.1",
    "i18next-browser-languagedetector": "^7.2.0",
    "lucide-react": "^0.533.0",
    "matter-js": "^0.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^14.1.0",
    "react-router-dom": "^6.30.1",
    "react-use": "^17.6.0",
    "three": "^0.179.1",
    "zod": "^3.25.67",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/matter-js": "^0.20.0",
    "@types/node": "^24.0.14",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.5.2",
    "@youware/vite-plugin-react": "^1.0.3",
    "autoprefixer": "^10.4.21",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "jimp": "^1.6.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "vite": "^7.0.0",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "build": {
    "appId": "store.veradekorasyon.oyun",
    "productName": "veradekorasyon Oyun",
    "artifactName": "veradekorasyon-oyun.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!node_modules/**",
      "!dist/veradekorasyon-oyun-kurulum.zip",
      "!dist/yw_manifest.json"
    ],
    "asar": false,
    "compression": "store",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "veradekorasyon Oyun",
      "uninstallDisplayName": "veradekorasyon Oyun",
      "runAfterFinish": true
    }
  }
}
